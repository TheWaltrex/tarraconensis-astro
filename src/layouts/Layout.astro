---
interface Props {
    title?: string;
    description?: string;
}
const {
    title = "Tarraconensis",
    description = "Tarraconensis – Arqueología, monumentos e historia del Imperio Romano y la Hispania Romana"
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, "");
const isHomeOrMenu = pathname === "" || pathname === "/menu";
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Tarraconensis, Hispania, Imperio Romano, arqueología, monumentos romanos" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=DM+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet"
    />
</head>
<body>
    <header class="site-header">
        <nav class="header-nav">
            <a href="/menu" class="header-menu-link" title="Menú principal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </a>
            <a href="/" class="site-logo">TARRACONENSIS</a>
            <a href="/hispania/laespanaromana" class="header-section-link">Hispania</a>
        </nav>
    </header>

    <main class="site-main">
        <article class="site-content">
            <slot />
        </article>
    </main>

    {!isHomeOrMenu && (
        <nav class="site-menu-btn">
            <a href="/menu">MENÚ</a>
        </nav>
    )}

    <footer class="site-footer">
        <p>Tarraconensis · Patrimonio romano en la Península Ibérica</p>
    </footer>

    <style is:global>

    /* =====================================================
       RESET COMPLETO
    ===================================================== */
    *, *::before, *::after {
        box-sizing: border-box;
    }

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
    }

    html {
        scroll-behavior: smooth;
    }

    /* =====================================================
       VARIABLES
    ===================================================== */
    :root {
        --gold:   #c5a059;
        --gold-l: #f0d595;
        --gold-a: rgba(197,160,89,.12);
        --gold-b: rgba(197,160,89,.22);
        --gold-c: rgba(197,160,89,.40);
        --bg:     #0c0c0e;
        --card:   #13131a;
        --card-h: #1a1a24;
        --fg:     #e4ddd1;
        --fgd:    #a49a8a;
        --fgm:    #6b6358;
        --f:      "DM Sans", system-ui, sans-serif;
        --ft:     "Cinzel", Georgia, serif;
        --radius: 8px;
        --transition: .2s cubic-bezier(.4,0,.2,1);
    }

    /* =====================================================
       BODY
    ===================================================== */
    body {
        background: var(--bg);
        background-image: radial-gradient(ellipse 80% 40% at 50% -5%,
            rgba(197,160,89,.05), transparent);
        color: var(--fg);
        font-family: var(--f);
        font-size: 16px;
        line-height: 1.7;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
    }

    /* =====================================================
       HEADER
    ===================================================== */
    .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 56px;
        padding: 0 24px;
        background: rgba(12,12,14,.94);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(197,160,89,.15);
    }

    .header-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
        width: 100%;
        max-width: 900px;
    }

    .site-logo {
        font-family: var(--ft);
        font-size: clamp(14px, 2.8vw, 20px);
        font-weight: 600;
        letter-spacing: .22em;
        color: var(--gold);
        text-decoration: none;
        white-space: nowrap;
        transition: opacity var(--transition);
    }
    .site-logo:hover { opacity: .7; }

    .header-menu-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--fgd);
        text-decoration: none;
        padding: 6px;
        border-radius: 6px;
        transition: color var(--transition), background var(--transition);
    }
    .header-menu-link:hover {
        color: var(--gold);
        background: rgba(197,160,89,.08);
    }

    .header-section-link {
        font-family: var(--ft);
        font-size: 12px;
        font-weight: 400;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--fgm);
        text-decoration: none;
        transition: color var(--transition);
    }
    .header-section-link:hover {
        color: var(--gold);
    }

    /* =====================================================
       MAIN WRAPPER
    ===================================================== */
    .site-main {
        flex: 1;
        width: 100%;
        /* Padding horizontal fluido — 16px mínimo, nunca más de 40px */
        padding: 36px max(16px, calc(50% - 460px)) 60px;
    }

    .site-content {
        max-width: 900px;
        width: 100%;
        margin: 0 auto;
    }

    /* =====================================================
       BOTÓN MENÚ — pequeño, limpio y centrado al final
    ===================================================== */
    .site-menu-btn {
        text-align: center;
        padding: 18px 0 6px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .site-menu-btn a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--ft);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--gold);
        text-decoration: none;
        background: rgba(197,160,89,.05);
        border: 1px solid rgba(197,160,89,.22);
        border-radius: 4px;
        padding: 6px 20px;
        transition: background var(--transition), border-color var(--transition), color var(--transition), transform var(--transition);
    }
    .site-menu-btn a:hover {
        background: rgba(197,160,89,.14);
        border-color: rgba(197,160,89,.45);
        color: var(--gold-l);
        transform: translateY(-1px);
    }

    /* Ocultar enlaces de menú legacy duplicados en el contenido */
    .site-content a[href="/menu"],
    .site-content a[href="/menu/"],
    .site-content a[href="/menu.html"],
    .site-content a[href="menu.html"],
    .site-content a[href="menu"] {
        display: none !important;
    }
    .site-content .migrated-cell:has(a[href*="menu"]:only-child),
    .site-content .migrated-cell:has(p:has(a[href*="menu"]:only-child):only-child),
    .site-content .migrated-cell:has(b:has(a[href*="menu"]:only-child):only-child),
    .site-content .migrated-cell:has(p:has(b:has(a[href*="menu"]:only-child)):only-child) {
        display: none !important;
    }

    /* =====================================================
       FOOTER
    ===================================================== */
    .site-footer {
        text-align: center;
        padding: 20px 24px;
        border-top: 1px solid rgba(197,160,89,.12);
        color: var(--fgm);
        font-size: 12px;
        letter-spacing: .07em;
        text-transform: uppercase;
    }
    .site-footer p { margin: 0; }

    /* =====================================================
       IMÁGENES — siempre fluidas
    ===================================================== */
    .site-content img {
        max-width: 100%;
        height: auto;
        width: auto;
        display: block;
        border-radius: var(--radius);
        margin-top: 12px;
        margin-bottom: 12px;
        margin-left: auto;
        margin-right: auto;
        transition: opacity var(--transition), transform var(--transition);
    }

    /* =====================================================
       TIPOGRAFÍA BASE
    ===================================================== */
    .site-content h1,
    .site-content h2,
    .site-content h3 {
        font-family: var(--ft);
        font-weight: 600;
        line-height: 1.25;
        text-align: center;
        letter-spacing: .04em;
        overflow-wrap: break-word;
        word-break: break-word;
    }

    /* El primer h1 del legacy se oculta */
    .site-content > h1:first-child,
    .site-content > div > h1:first-child,
    .site-content > hr:first-child { display: none; }

    .site-content h1 {
        font-size: clamp(1.25rem, 4vw, 1.8rem);
        color: var(--fg);
        margin: 1.75rem 0 .8rem;
    }

    .site-content h2 {
        font-size: clamp(1.05rem, 3vw, 1.4rem);
        color: var(--gold);
        margin: 1.5rem 0 .6rem;
        position: relative;
        padding-bottom: .5rem;
    }
    /* Decoración dorada sutil bajo h2 */
    .site-content h2::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 40px;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
        border-radius: 1px;
    }

    .site-content h3 {
        font-size: clamp(.9rem, 2.5vw, 1.15rem);
        color: var(--fgd);
        margin: 1.25rem 0 .5rem;
    }

    /* Párrafos — lectura de libro / revista corrida a todo el ancho */
    .site-content p {
        margin: 0 0 1.1rem;
        overflow-wrap: break-word;
        word-break: break-word;
        hyphens: auto;
        color: var(--fg);
        text-align: justify;
        text-justify: inter-word;
        text-align-last: left;
        line-height: 1.8;
    }

    /* Centro heredado del HTML del legacy */
    .site-content p[align="center"],
    .site-content center,
    .site-content [align="center"] {
        text-align: center;
        text-align-last: center;
    }

    .site-content b, .site-content strong { font-weight: 600; }
    .site-content i, .site-content em    { color: var(--fgd); font-style: italic; }

    /* =====================================================
       SEPARADORES
    ===================================================== */
    .site-content hr {
        border: none;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(197,160,89,.25), transparent);
        margin: 2rem auto;
        max-width: 80px;
    }

    /* =====================================================
       ENLACES
    ===================================================== */
    .site-content a {
        color: var(--gold);
        text-decoration: none;
        border-bottom: 1px solid rgba(197,160,89,.3);
        padding-bottom: 1px;
        overflow-wrap: break-word;
        word-break: break-word;
        transition: color var(--transition), border-color var(--transition);
    }
    .site-content a:hover {
        color: var(--gold-l);
        border-bottom-color: var(--gold-l);
    }

    /* Links con imagen: sin subrayado */
    .site-content a:has(img) {
        border-bottom: none;
        display: inline-block;
        padding: 0;
    }
    .site-content a:has(img) img {
        transition: opacity var(--transition), transform var(--transition), box-shadow var(--transition);
    }
    .site-content a:has(img):hover img {
        opacity: .88;
        transform: scale(1.02);
        box-shadow: 0 4px 20px rgba(197,160,89,.15);
    }

    .site-content a[href^="mailto:"] {
        color: var(--fgm);
        font-size: .875rem;
        border-bottom-color: rgba(107,99,88,.3);
    }

    /* =====================================================
       TABLAS DE DATOS
    ===================================================== */
    .site-content table {
        width: 100%;
        border-collapse: collapse;
        font-size: .9rem;
        margin: 1.5rem 0;
        /* Scroll horizontal en pantallas pequeñas */
        display: block;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    /* Restaurar display de partes internas */
    .site-content thead,
    .site-content tbody,
    .site-content tfoot   { display: table-header-group; }
    .site-content tbody   { display: table-row-group; }
    .site-content tr      { display: table-row; }
    .site-content th,
    .site-content td {
        display: table-cell;
        padding: 8px 12px;
        border: 1px solid rgba(197,160,89,.18);
        text-align: left;
        vertical-align: top;
        overflow-wrap: break-word;
        word-break: break-word;
    }
    .site-content th {
        background: var(--card);
        color: var(--gold);
        font-weight: 600;
        font-family: var(--ft);
        font-size: .8rem;
        letter-spacing: .04em;
    }
    .site-content tr:nth-child(even) td {
        background: rgba(255,255,255,.016);
    }

    /* =====================================================
       ESTRUCTURA DE CONTENIDOS MIGRADOS (.migrated-layout)
       - Texto corrido en horizontal al 100% de ancho (libro/revista)
       - Enlaces y botones en cuadrícula horizontal limpia y centrada
       - Imágenes centradas y alineadas
    ===================================================== */
    .site-content .migrated-layout {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 24px;
        align-items: center;
        margin: 16px 0;
        justify-content: center;
        width: 100%;
    }

    .site-content .migrated-cell {
        flex: 0 1 auto;
        min-width: 0;
        overflow-wrap: break-word;
        word-break: break-word;
        text-align: center;
    }

    /* Celdas con texto o párrafos: ocupan el 100% del ancho para lectura corrida */
    .site-content .migrated-cell:has(p),
    .site-content .migrated-cell:has(br),
    .site-content .migrated-cell:has(i) {
        flex: 1 1 100%;
        width: 100%;
        text-align: justify;
        text-justify: inter-word;
        text-align-last: left;
    }

    /* Excepción: celdas con un único link corto o título breve centrado */
    .site-content .migrated-cell:has(> b > a:only-child),
    .site-content .migrated-cell:has(> p > b > a:only-child),
    .site-content .migrated-cell:has(> a:only-child) {
        flex: 0 1 auto;
        text-align: center;
        text-align-last: center;
    }

    /* Celda que solo contiene imagen: centrada */
    .site-content .migrated-cell:has(img:only-child),
    .site-content .migrated-cell:has(p:has(img:only-child)) {
        flex: 1 1 100%;
        width: 100%;
        text-align: center;
    }

    /* Párrafos dentro de celdas */
    .site-content .migrated-cell > p {
        margin-bottom: .8rem;
    }
    .site-content .migrated-cell > p[align="center"] {
        text-align: center;
        text-align-last: center;
    }



    /* =====================================================
       LISTAS
    ===================================================== */
    .site-content ul,
    .site-content ol {
        padding-left: 1.4rem;
        margin: .75rem 0;
    }
    .site-content li { margin-bottom: .2rem; }

    /* =====================================================
       LIMPIEZA HTML LEGACY
    ===================================================== */
    .site-content o\:p       { display: none; }
    .site-content .MsoNormal { margin: 0; min-height: 0; }
    .site-content span:empty { display: none; }
    .site-content font       { color: inherit; font-family: inherit; font-size: inherit; }

    .site-content br + br    { display: none; }

    /* =====================================================
       ANIMACIÓN BLINK
    ===================================================== */
    .blink-effect {
        animation: blink 2.5s ease-in-out infinite;
    }
    @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: .25; }
    }

    /* =====================================================
       SELECTION
    ===================================================== */
    ::selection {
        background: rgba(197,160,89,.3);
        color: var(--fg);
    }

    /* =====================================================
       SCROLLBAR
    ===================================================== */
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb {
        background: rgba(197,160,89,.2);
        border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(197,160,89,.35); }

    /* =====================================================
       RESPONSIVE
    ===================================================== */
    @media (max-width: 600px) {
        body { font-size: 15px; }

        .site-main {
            padding: 20px 16px 48px;
        }

        .header-section-link { display: none; }

        /* En móvil todas las celdas migradas van a 100% */
        .site-content .migrated-cell {
            flex-basis: 100%;
        }
    }

    @media (max-width: 380px) {
        body { font-size: 14px; }
        .site-main { padding: 16px 12px 40px; }
    }

    </style>
</body>
</html>
