<style>

.menu-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

/* Letras doradas */
.menu-letters {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 2px;
  padding: 12px 0 8px;
}
.menu-letters img {
  width: clamp(30px, 5vw, 50px);
  height: auto;
  object-fit: contain;
  display: block;
  margin: 0;
  border-radius: 0;
}

/* Social */
.menu-social {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  padding: 8px 0 12px;
}
.menu-social a {
  border-bottom: none;
  display: inline-flex;
  opacity: .7;
  transition: opacity .2s;
}
.menu-social a:hover { opacity: 1; }
.menu-social img {
  height: 30px;
  width: auto;
  display: block;
  margin: 0;
  border-radius: 4px;
}
.menu-social-sep {
  width: 1px;
  height: 24px;
  background: rgba(197,160,89,.2);
}

/* Monumentos CTA */
.menu-monumentos {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 4px 0 12px;
}
.menu-monumentos img {
  height: 32px;
  width: auto;
  display: block;
  margin: 0;
  opacity: .8;
  border-radius: 4px;
}
.menu-monumentos a {
  font-family: "Cinzel", Georgia, serif;
  font-size: clamp(14px, 2.5vw, 18px);
  font-weight: 600;
  letter-spacing: .1em;
  color: #c5a059;
  text-decoration: none;
  border-bottom: none;
}
.menu-monumentos a:hover { color: #f0d595; }

/* Divider */
.menu-divider {
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(197,160,89,.2), transparent);
  margin: 4px 0;
}

/* Grid 3 columnas */
.menu-grid {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0;
  align-items: center;
  width: 100%;
  padding: 8px 0;
}

.menu-col {
  display: flex;
  flex-direction: column;
}
.menu-col a {
  display: block;
  padding: 9px 20px;
  font-size: clamp(14px, 2.2vw, 16px);
  font-weight: 500;
  color: #c8c0b0;
  text-decoration: none;
  border-bottom: 1px solid rgba(197,160,89,.06);
  transition: color .15s, background .15s;
}
.menu-col a:last-child { border-bottom: none; }
.menu-col a:hover {
  color: #c5a059;
  background: rgba(197,160,89,.05);
}

/* Columna izquierda → texto a la derecha */
.menu-grid .menu-col:first-child a { text-align: right; }
/* Columna derecha → texto a la izquierda */
.menu-grid .menu-col:last-child a { text-align: left; }

.menu-eventos {
  color: #c5a059 !important;
  animation: menu-blink 2.5s ease-in-out infinite;
}
@keyframes menu-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: .3; }
}

/* Loba central */
.menu-loba {
  display: flex;
  justify-content: center;
  padding: 0 20px;
}
.menu-loba img {
  width: clamp(160px, 22vw, 280px);
  height: auto;
  display: block;
  border-radius: 8px;
  box-shadow: 0 0 0 1px rgba(197,160,89,.15), 0 6px 24px rgba(0,0,0,.5);
  margin: 0;
}

/* Secciones */
.menu-sections {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0;
  padding: 8px 0;
  width: 100%;
}
.menu-sections a {
  font-family: "Cinzel", Georgia, serif;
  font-size: clamp(12px, 2vw, 15px);
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #d6cfc3;
  text-decoration: none;
  border-bottom: none;
  padding: 12px clamp(14px, 4vw, 36px);
  transition: color .15s;
  position: relative;
}
.menu-sections a:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 1px;
  background: rgba(197,160,89,.2);
}
.menu-sections a:hover { color: #c5a059; }

/* Pie */
.menu-foot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 16px 0 4px;
  font-size: 13px;
  color: #6b6358;
}
.menu-foot a {
  color: #6b6358;
  border: none;
  text-decoration: none;
}
.menu-foot a:hover { color: #c5a059; }

/* Responsive */
@media (max-width: 768px) {
  .menu-grid {
    grid-template-columns: 1fr;
    gap: 4px;
  }
  .menu-loba { order: -1; padding: 8px 0; }
  .menu-loba img { width: min(200px, 50vw); }
  .menu-grid .menu-col:first-child a,
  .menu-grid .menu-col:last-child a {
    text-align: center;
  }
  .menu-grid .menu-col:last-child {
    border-top: 1px solid rgba(197,160,89,.08);
  }
}

@media (max-width: 480px) {
  .menu-sections {
    flex-direction: column;
    align-items: stretch;
  }
  .menu-sections a {
    text-align: center;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(197,160,89,.06);
  }
  .menu-sections a:not(:last-child)::after { display: none; }
  .menu-sections a:last-child { border-bottom: none; }
}

</style>
